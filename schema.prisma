  idempotencyKey                 String               @unique @default("")
  processedAt                    DateTime?
  createdAt                      DateTime?            @default(now())
  updatedAt                      DateTime?            @updatedAt
  from_PaymentObservation_refund PaymentObservation[] @relation("PaymentObservation_refund")

  @@index([paymentId])
  @@index([providerId])
  @@index([createdAt])
  @@index([updatedAt])
}

