  updatedAt                DateTime? @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

model Payment {
  id                              String               @id @default(cuid())
  trip                            Trip?                @relation("Payment_trip", fields: [tripId], references: [id])
  tripId                          String?              @map("trip")
  provider                        PaymentProvider?     @relation("Payment_provider", fields: [providerId], references: [id])
  providerId                      String?              @map("provider")
  amountMinor                     Int?
  currencyCode                    String               @default("")
  status                          String?              @default("pending")
  providerReference               String               @default("")
  idempotencyKey                  String               @unique @default("")
  providerEvidence                Json?                @default("{}")
  capturedAt                      DateTime?
  refunds                         Refund[]             @relation("Refund_payment")
  ledgerEntries                   LedgerEntry[]        @relation("LedgerEntry_payment")
  createdAt                       DateTime?            @default(now())
  updatedAt                       DateTime?            @updatedAt
  from_PaymentObservation_payment PaymentObservation[] @relation("PaymentObservation_payment")

  @@index([tripId])
  @@index([providerId])
  @@index([createdAt])
  @@index([updatedAt])
}

model Refund {
