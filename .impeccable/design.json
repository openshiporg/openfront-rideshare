  "components": [
    {
      "name": "Operator Primary Track Button",
      "kind": "button",
      "refersTo": "track-button-primary",
      "description": "The one forward action on an operator screen (offer, assign, save).",
      "html": "<button class=\"ds-track-primary\">Offer ride</button>",
      "css": ".ds-track-primary{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:0 12px;border:1px solid oklch(0.7 0.15 88);border-radius:4px;background:oklch(0.86 0.165 92);color:oklch(0.18 0.01 90);font:600 14px/1 Geist,system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-track-primary:hover{background:oklch(0.81 0.165 88)}.ds-track-primary:focus-visible{outline:none;box-shadow:0 0 0 2px oklch(0.705 0.015 286)}"
    },
    {
      "name": "Operator Default Track Button",
      "kind": "button",
      "refersTo": "track-button-default",
      "description": "Secondary operator command inside an ActionTrack.",
      "html": "<button class=\"ds-track\">Decline</button>",
      "css": ".ds-track{display:inline-flex;align-items:center;min-height:32px;padding:0 12px;border:1px solid oklch(0.92 0.004 286);border-radius:4px;background:#fff;color:oklch(0.141 0.005 286);font:500 14px/1 Geist,system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-track:hover{background:oklch(0.967 0.001 286)}.ds-track:focus-visible{outline:none;box-shadow:0 0 0 2px oklch(0.705 0.015 286)}"
    },
    {
      "name": "Operator Underline Tabs",
      "kind": "nav",
      "refersTo": "pill-track",
      "description": "Status views on every operations board; current tab carries the yellow rule.",
      "html": "<div class=\"ds-tabs\"><a class=\"ds-tab ds-tab-on\" href=\"#\">Waiting <span>3</span></a><a class=\"ds-tab\" href=\"#\">Offered <span>1</span></a><a class=\"ds-tab\" href=\"#\">Cancelled <span>0</span></a></div>",
      "css": ".ds-tabs{display:flex;gap:20px;align-items:flex-end;border-bottom:1px solid oklch(0.92 0.004 286);font:400 14px/1 Geist,system-ui,sans-serif}.ds-tab{display:inline-flex;gap:6px;align-items:center;min-height:40px;margin-bottom:-1px;border-bottom:2px solid transparent;color:oklch(0.552 0.016 286);text-decoration:none;transition:color .15s,border-color .15s}.ds-tab span{font-size:12px;font-variant-numeric:tabular-nums slashed-zero;opacity:.7}.ds-tab:hover{color:oklch(0.141 0.005 286);border-color:oklch(0.92 0.004 286)}.ds-tab:focus-visible{outline:none;text-decoration:underline;color:oklch(0.141 0.005 286)}.ds-tab-on,.ds-tab-on:hover{border-color:oklch(0.7 0.15 88);color:oklch(0.141 0.005 286);font-weight:500}"
    },
    {
      "name": "Plate",
      "kind": "chip",
      "refersTo": "plate",
      "description": "A vehicle registration set like a licence plate.",
      "html": "<span class=\"ds-plate\">HIM 0042</span>",
      "css": ".ds-plate{display:inline-flex;align-items:center;height:20px;padding:0 6px;border:1px solid oklch(0.86 0.03 95);border-radius:3px;background:oklch(0.975 0.01 95);color:oklch(0.141 0.005 286);font:600 11px/1 'Geist Mono',ui-monospace,monospace;letter-spacing:.025em;text-transform:uppercase;font-variant-numeric:tabular-nums slashed-zero}"
    },
    {
      "name": "Status Title",
      "kind": "custom",
      "refersTo": "status-title",
      "description": "Request or trip heading with a square status mark and status label.",
      "html": "<h3 class=\"ds-status\"><span class=\"ds-mark\"></span><span class=\"ds-id\">RQ-1042</span><span class=\"ds-label\">Matching</span></h3>",
      "css": ".ds-status{display:flex;align-items:baseline;gap:8px;margin:0;font:600 14px/1.4 'Geist Mono',ui-monospace,monospace}.ds-mark{width:8px;height:8px;border-radius:1px;background:#f59e0b;align-self:center}.ds-label{font:500 12px/1 Geist,system-ui,sans-serif;color:oklch(0.552 0.016 286)}"
    },
    {
      "name": "Rider Signal Button",
      "kind": "button",
      "refersTo": "rider-button-signal",
      "description": "The single forward action on a rider page: See price, Request ride, Track ride.",
      "html": "<button class=\"ds-signal\">See price <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-signal{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:52px;padding:0 24px;border:0;border-radius:3px;background:#ffd23f;color:#09090b;font:600 16px/1 Geist,system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-signal:hover{background:#ffdb63}.ds-signal:focus-visible{outline:none;box-shadow:0 0 0 2px #0b0d10,0 0 0 4px #ffd23f}"
    },
    {
      "name": "Rider Raised Button",
      "kind": "button",
      "refersTo": "rider-button-raised",
      "description": "Secondary rider command on lane with a faint ring.",
      "html": "<button class=\"ds-raised\">My rides</button>",
      "css": ".ds-raised{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border:0;border-radius:3px;background:#1c2027;color:#f3f2ee;box-shadow:inset 0 0 0 1px rgba(255,255,255,.2);font:600 14px/1 Geist,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,box-shadow .15s}.ds-raised:hover{background:#232831;box-shadow:inset 0 0 0 1px rgba(255,255,255,.35)}.ds-raised:focus-visible{outline:none;box-shadow:0 0 0 2px #ffd23f}"
    },
    {
      "name": "Rider Choice",
      "kind": "chip",
      "refersTo": "rider-pill",
      "description": "Square kerb choice (Now / Schedule, Sign in / Create account); chosen carries the signal edge.",
      "html": "<div class=\"ds-rtrack\"><button class=\"ds-rpill ds-rpill-on\">Now</button><button class=\"ds-rpill\">Schedule</button></div>",
      "css": ".ds-rtrack{display:inline-flex;gap:8px;padding:12px;background:#14171c}.ds-rpill{min-height:40px;padding:0 16px;border:1px solid rgba(255,255,255,.15);border-radius:3px;background:transparent;color:#9aa0aa;font:400 14px/1 Geist,system-ui,sans-serif;cursor:pointer;transition:border-color .15s,color .15s}.ds-rpill:hover{border-color:rgba(255,255,255,.35);color:#f3f2ee}.ds-rpill:focus-visible{outline:none;box-shadow:0 0 0 2px #ffd23f}.ds-rpill-on,.ds-rpill-on:hover{border-color:#ffd23f;background:#1c2027;color:#f3f2ee;font-weight:600}"
    },
    {
      "name": "Rider Route Field",
      "kind": "input",
      "refersTo": "rider-field",
      "description": "Pickup and destination in one asphalt well joined by the dashed route line.",
      "html": "<div class=\"ds-route\"><span class=\"ds-line\"></span><label class=\"ds-stop\"><span class=\"ds-from\"></span><input placeholder=\"Pickup\"></label><hr><label class=\"ds-stop\"><span class=\"ds-to\"></span><input placeholder=\"Where to?\"></label></div>",
      "css": ".ds-route{position:relative;width:340px;border-radius:6px;background:#0b0d10;box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}.ds-line{position:absolute;left:21px;top:26px;bottom:26px;width:1px;background:linear-gradient(to bottom,#9aa0aa 50%,transparent 0);background-size:1px 6px}.ds-stop{display:flex;align-items:center;gap:12px;padding:4px 16px}.ds-from{position:relative;width:12px;height:12px;box-sizing:border-box;border:3px solid #f3f2ee;border-radius:4px;background:#0b0d10}.ds-to{position:relative;width:12px;height:12px;border-radius:3px;background:#ffd23f}.ds-route input{height:48px;flex:1;border:0;background:transparent;color:#f3f2ee;font:500 16px Geist,system-ui,sans-serif;outline:none}.ds-route input::placeholder{color:rgba(154,160,170,.8)}.ds-route hr{margin:0 0 0 44px;border:0;border-top:1px solid rgba(255,255,255,.1)}.ds-route:focus-within{box-shadow:inset 0 0 0 2px #ffd23f}"
    },
    {
      "name": "Quote Slip",
      "kind": "card",
      "refersTo": "rider-quote-slip",
      "description": "The bound price as a signal-yellow meter slip: fare, expiry, fees in one reading.",
      "html": "<div class=\"ds-slip\"><div class=\"ds-slip-top\"><div><p class=\"ds-slip-k\">Standard</p><p class=\"ds-fare\">$18.40</p></div><span class=\"ds-exp\">4:59</span></div><dl class=\"ds-fees\"><div><dt>Base</dt><dd>$4.00</dd></div><div><dt>Distance</dt><dd>$12.10</dd></div><div><dt>Fees</dt><dd>$2.30</dd></div></dl></div>",
